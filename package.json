{
  "name": "phd-daily-review",
  "version": "1.1.15",
  "description": "博士日课 Windows 桌面版",
  "main": "electron-main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.phddaily.review",
    "productName": "博士日课",
    "directories": {
      "output": "release-1.1.15"
    },
    "files": [
      "**/*",
      "!release{,/**}",
      "!release-1.0.1{,/**}",
      "!release-1.0.2{,/**}",
      "!release-1.0.3{,/**}",
      "!release-1.0.3-build{,/**}",
      "!release-1.0.4{,/**}",
      "!release-1.0.5{,/**}",
      "!release-1.0.6{,/**}",
      "!release-1.0.7{,/**}",
      "!release-1.0.8{,/**}",
      "!release-1.0.9{,/**}",
      "!release-1.0.10{,/**}",
      "!release-1.0.11{,/**}",
      "!release-1.0.12{,/**}",
      "!release-1.0.13{,/**}",
      "!release-1.0.14{,/**}",
      "!release-1.0.15{,/**}",
      "!release-1.0.16{,/**}",
      "!release-1.0.17{,/**}",
      "!release-1.0.18{,/**}",
      "!release-1.0.19{,/**}",
      "!release-1.1.0{,/**}",
      "!release-1.1.1{,/**}",
      "!release-1.1.2{,/**}",
      "!release-1.1.3{,/**}",
      "!release-1.1.4{,/**}",
      "!release-1.1.5{,/**}",
      "!release-1.1.6{,/**}",
      "!release-1.1.7{,/**}",
      "!release-1.1.8{,/**}",
      "!release-1.1.9{,/**}",
      "!release-1.1.10{,/**}",
      "!release-1.1.11{,/**}",
      "!release-1.1.12{,/**}",
      "!release-1.1.13{,/**}",
      "!release-1.1.14{,/**}",
      "!release-1.1.15{,/**}",
      "!node_modules{,/**}/**/*.{md,map}",
      "!build-*.log",
      "!launch-*.log",
      "!CHANGELOG.md",
      "!README.md",
      "!supabase-schema.sql"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "博士日课"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
