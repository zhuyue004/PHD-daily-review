{
  "name": "phd-daily-review",
  "version": "1.0.0",
  "description": "博士日课 Windows 桌面版",
  "main": "electron-main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.phddaily.review",
    "productName": "博士日课",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release{,/**}",
      "!node_modules{,/**}/**/*.{md,map}",
      "!README.md"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "博士日课"
    }
  }
}
